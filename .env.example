# Copy to .env and fill in any keys you have. Every key is optional;
# sources without a key are shown as "skipped".
HIBP_API_KEY=          # haveibeenpwned.com/API/Key (paid)
SHODAN_API_KEY=        # account.shodan.io (free tier works)
VT_API_KEY=            # virustotal.com (free)
ABUSEIPDB_API_KEY=     # abuseipdb.com (free)
OTX_API_KEY=           # otx.alienvault.com (free) — passive DNS history, threat intel
HUNTER_API_KEY=        # hunter.io (free tier) — staff emails for a domain, mailbox verification
IPINFO_TOKEN=          # ipinfo.io (free, raises rate limit)
GITHUB_TOKEN=          # github.com/settings/tokens (raises rate limit)
NUMVERIFY_API_KEY=     # numverify.com (free tier)
OSINT_DEFAULT_REGION=US   # region for phone numbers without a +country code
